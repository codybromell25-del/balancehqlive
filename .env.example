# ---- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Momence ---------------------------------------------------------------
MOMENCE_API_BASE=https://api.momence.com

# ---- Secrets ---------------------------------------------------------------
# 32 bytes, base64. Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# Shared secret for Vercel cron authentication.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Reject webhooks that fail signature verification. Keep this true.
# Set to false only while confirming the signature scheme with Momence.
WEBHOOK_VERIFICATION_STRICT=true

# ---- App -------------------------------------------------------------------
# Used by scripts/add-studio.ts to print the correct webhook URL.
APP_URL=https://your-app.vercel.app
